{
  "name": "spotify-metadata-scraper",
  "version": "1.0.0",
  "description": "Monitor public Spotify playlists, albums, artist top tracks, podcast shows, episodes, and metadata changes.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/*.test.js",
    "lint": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "apify": "^3.4.2",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "basic-ftp": "6.2.3"
  }
}
